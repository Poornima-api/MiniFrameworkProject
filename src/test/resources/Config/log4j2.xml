<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

<Appenders>

    <File name="FileLogger"
          fileName="Logs/application.log">

        <PatternLayout
            pattern="%d %p %c [%t] %m%n"/>
    </File>

</Appenders>

<Loggers>

    <Root level="info">

        <AppenderRef ref="FileLogger"/>

    </Root>

</Loggers>

</Configuration>